APP_ENV=production
SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DB_HOST:5432/abc_solutions?sslmode=require
SESSION_COOKIE_SECURE=true
MFA_REQUIRED=true
AUTO_INIT_DB=false
TRUSTED_HOSTS=app.example.com
PORT=8000
# set to trusted reverse proxy IP
FORWARDED_ALLOW_IPS=127.0.0.1,::1
